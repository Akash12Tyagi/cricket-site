# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
DATABASE_URL=postgres://cricket:cricket_dev_only@127.0.0.1:5440/cricket
REDIS_URL=redis://127.0.0.1:6380
API_PORT=4000
# The browser-facing origin; state-changing requests must come from here (CSRF guard).
WEB_ORIGIN=http://localhost:3100
# 32+ random bytes, e.g. `openssl rand -base64 48`. Used to HMAC login codes and session tokens.
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Cricket <no-reply@localhost>"
# Where the Next.js server proxies /api/* (same-origin cookies, no CORS).
API_INTERNAL_URL=http://127.0.0.1:4000
# Public URL of the site (canonical links, sitemap, share images).
SITE_URL=http://localhost:3100
# On-demand page refresh (API -> web, private network). Secret: openssl rand -hex 32 (same value for both apps).
# WEB_INTERNAL_URL=http://127.0.0.1:3100
# REVALIDATE_SECRET=<64 hex chars>
# Production behind a CDN: header carrying the real visitor IP (only with an origin firewall that admits the CDN alone).
# CLIENT_IP_HEADER=cf-connecting-ip

# Live-score feed worker (pnpm --filter @cricket/api feed). none = only official YouTube videos are fetched.
# highlightly = fixtures, live scores and scorecards (free plan 100 requests/day); sportmonks = ball-by-ball (paid).
FEED_PROVIDER=none
# HIGHLIGHTLY_API_KEY=<from highlightly.net dashboard>   (secret: never commit, never log)
# HIGHLIGHTLY_DAILY_REQUESTS=100
# HIGHLIGHTLY_MIN_LIST_SECONDS=15
# SPORTMONKS_API_TOKEN=<from my.sportmonks.com>   (secret: never commit, never log)
# FEED_POLL_SECONDS=5
# FEED_AUTO_CREATE=true
# YOUTUBE_POLL_MINUTES=10
# Free YouTube Data API v3 key (Google Cloud, no billing): full back catalogues + view counts. Secret: never commit.
# YOUTUBE_API_KEY=
# YOUTUBE_DAILY_UNITS=8000

# Live video (Watch tab): hosts we may play from, and the worker's re-check interval. See docs/LIVE-VIDEO.md.
# STREAM_HLS_HOSTS=media.your-provider.com
# STREAM_EMBED_HOSTS=player.board.example
# STREAM_TOKEN_PARAM=token
# STREAM_TOKEN_PROVIDER=<access token from your licence: secret, never commit>
# STREAM_CHECK_SECONDS=60
